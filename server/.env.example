PORT=5000
CLIENT_URL=http://localhost:5173

# YouTube API Credentials
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:5000/auth/youtube/callback

# Spotify API Credentials
# Note: Spotify requires 127.0.0.1 (not localhost) for HTTP loopback redirect URIs
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/auth/spotify/callback

# Session Secret (generate a random string)
SESSION_SECRET=your_random_session_secret_minimum_32_characters_long
